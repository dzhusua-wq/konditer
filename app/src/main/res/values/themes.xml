<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="brand">#E86A92</color>
    <color name="brand_bg">#FFF1F5</color>

    <style name="SettingsHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Material3.TitleSmall</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="RoundedThumb">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

    <style name="Theme.Konditer" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">#FFB1C8</item>
        <item name="colorOnPrimary">#5E1133</item>
        <item name="colorPrimaryContainer">#7B2949</item>
        <item name="colorOnPrimaryContainer">#FFD9E2</item>
        <item name="colorSecondaryContainer">#5A3F47</item>
        <item name="colorOnSecondaryContainer">#FFD9E2</item>
    </style>
</resources>
